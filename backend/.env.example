# Copy to .env. One Google account per DATA_DIR; use a new directory for a different account.
# DATA_DIR=/absolute/private/path/photo-curator-data
# Chrome extension ID from chrome://extensions (32 lowercase a-p characters).
PC_EXTENSION_IDS=
# The server refuses all live trash operations unless explicitly enabled here.
PC_ENABLE_LIVE_TRASH=0
# Optional, local OpenCLIP ViT-B-32 weights. Never downloaded automatically by the app.
# PC_CLIP_CHECKPOINT=/absolute/path/open_clip_pytorch_model.bin
