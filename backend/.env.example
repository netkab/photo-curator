# Copy to .env and edit. All keys are optional except paths you actually use.

# --- Paths ---
# Where you unzipped your Google Takeout export (the photo-ingest default source).
TAKEOUT_DIR=D:\Takeout
# Optional working library root (if you copy/normalize originals). Defaults to TAKEOUT_DIR.
LIBRARY_DIR=
# Catalog DB + thumbnails + derived media + exports live here (gitignored).
DATA_DIR=
# Where `cli reclaim` MOVES redundant local duplicates (it never deletes). Defaults to a sibling of
# TAKEOUT_DIR named "<name>_quarantine". Keep it on the SAME drive — a same-volume move is instant,
# whereas crossing drives copies every byte and can half-finish.
QUARANTINE_DIR=

# --- Local AI ---
# Ollama endpoint for the captioning model.
OLLAMA_HOST=http://127.0.0.1:11434
CAPTION_MODEL=moondream
# Hugging Face model id for OCR/detection.
OCR_MODEL=microsoft/Florence-2-large

# --- Google Places (READ-ONLY place search for Maps Studio) ---
# Without this, Maps Studio still drafts reviews offline using raw coordinates.
GOOGLE_PLACES_API_KEY=

# --- Google Photos upload (appendonly, NEW album only) ---
# Without these, uploads are disabled and approved files are exported to a folder for you to upload
# by hand. The extension's "retire the original" step stays blocked until a replacement is actually
# uploaded, so setting these is what makes the enhance/compress loop automatic.
#
# One-time setup (~5 minutes, free):
#   1. https://console.cloud.google.com/  ->  create a project (any name)
#   2. APIs & Services -> Library -> enable "Photos Library API"
#   3. APIs & Services -> OAuth consent screen -> External -> fill the required fields
#      -> Audience -> Test users -> add your own Gmail address
#      (Testing mode is fine and never needs verification for personal use.)
#   4. Credentials -> Create credentials -> OAuth client ID -> Desktop app
#   5. Paste the client id/secret below
# The first upload opens a browser consent window and caches a token in DATA_DIR.
# Scope requested is photoslibrary.appendonly ONLY — by Google's design that token cannot read,
# edit or delete anything already in your library.
PHOTOS_OAUTH_CLIENT_ID=
PHOTOS_OAUTH_CLIENT_SECRET=
PHOTOS_UPLOAD_ALBUM=Photo Curator (curated)
